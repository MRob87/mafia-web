# Production build config. NEXT_PUBLIC_* vars are inlined into the client bundle
# (they are NOT secret). `next build` reads this file automatically.
# The client connects to the API over HTTPS so the browser doesn't block it as
# mixed content. See apps/web/lib/socket.ts for the fallback used in dev/LAN.
NEXT_PUBLIC_SERVER_URL=https://mafiaweb.duckdns.org
